# ============================================================
# 本地开发配置模板（excel-import-service）
#
# 用法：复制为同目录下的 application.yml（该文件已被 .gitignore 排除，不会提交）
#     cp config/application.yml.example config/application.yml
#
# 为什么本服务「必须」有它：
#   本服务 classpath 里的 application.yml 把 nacos 默认值写成了容器名
#   1Panel-nacos-qquH-standalone，宿主机解析不了，
#   因此本地直接启动会注册失败（fail-fast 默认 true → 启动即失败）。
#   本文件把地址覆盖成本机 Nacos 即可恢复本地开发能力。
#
#   容器内工作目录没有 config/，本文件不被加载，
#   容器仍走 prod 配置 + compose 的 NACOS_SERVER_ADDR，完全不受影响。
#
# 为什么不共享：
#   本文件被 .gitignore 排除 → 每台机器各存一份，互不覆盖、不会误提交。
#
# ────────────────────────────────────────────────────────────
# ⚠️ Nacos 地址最容易填错的地方（已实测踩过）
#
#   server-addr 要填「服务端 API」端口，不是「控制台」端口。
#   Nacos 3.x 起两者分开了：
#       服务端 API  :8848    ← server-addr 填这个
#       控制台      :8080    ← 浏览器里打开的地址，填进 server-addr 必然注册失败
#
#   自检命令（返回 200 就说明这是服务端 API）：
#     curl -s -o /dev/null -w "%{http_code}\n" \
#          http://<nacos-host>:8848/nacos/v1/ns/operator/metrics
# ────────────────────────────────────────────────────────────
#
# 三个环境（本文件只管「本地」这一档）：
#
#   家里       : 192.168.3.7:8848
#   公司       : 127.0.0.1:8848
#   远程服务器 : 不用本文件！容器内没有 config/，走 prod 配置 + compose 环境变量
# ============================================================

spring:
  cloud:
    nacos:
      discovery:
        # 按你当前所在环境改成上面三个值之一
        server-addr: 192.168.3.7:8848
